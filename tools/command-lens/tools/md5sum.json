{
  "$schema": "../schema/tool.schema.json",
  "id": "md5sum",
  "name": "md5sum",
  "aliases": [
    "md5",
    "hash"
  ],
  "kind": "native",
  "shells": [
    {
      "id": "bash"
    },
    {
      "id": "zsh"
    }
  ],
  "category": "hashing",
  "summary": "Computes or checks MD5 hashes.",
  "action": "hashes files",
  "description": "MD5 is weak for integrity but still common in threat reports. Pipe into grep -F -i with the IOC set to find known files; for a whole tree use find … -exec md5sum {} +.",
  "source": "https://www.gnu.org/software/coreutils/manual/html_node/md5sum-invocation.html",
  "requires": {
    "elevation": "recommended"
  },
  "io": {
    "stdin": "text",
    "stdout": "text"
  },
  "template": "{binary} {flags} {path}",
  "params": [
    {
      "id": "check",
      "label": "Check list",
      "type": "path",
      "os": "linux",
      "flag": "-c",
      "conflicts": [
        "path",
        "tag"
      ],
      "placeholder": "hashes.md5",
      "explain": "verifying hashes listed in {value}"
    },
    {
      "id": "tag",
      "label": "BSD format",
      "type": "bool",
      "flag": "--tag",
      "explain": "BSD-style output"
    },
    {
      "id": "path",
      "label": "Files",
      "type": "path",
      "os": "linux",
      "slot": "path",
      "repeatable": true,
      "repeat": {
        "mode": "positional"
      },
      "expand": true,
      "common": true,
      "conflicts": [
        "check"
      ],
      "explain": "of {value}"
    }
  ],
  "presets": [
    {
      "id": "staging",
      "name": "Hash files in temp and shm",
      "values": {
        "path": [
          "/tmp/*",
          "/var/tmp/*",
          "/dev/shm/*"
        ]
      },
      "ttps": [
        "T1105"
      ],
      "opsec": "Globs skip hidden files; add /tmp/.* for those."
    }
  ],
  "ttps": [],
  "execSafe": true
}
