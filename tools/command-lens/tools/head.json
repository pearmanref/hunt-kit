{
  "$schema": "../schema/tool.schema.json",
  "id": "head",
  "name": "head",
  "aliases": [
    "first",
    "top"
  ],
  "kind": "native",
  "shells": [
    {
      "id": "bash"
    },
    {
      "id": "zsh"
    }
  ],
  "category": "text",
  "summary": "Keeps the first lines.",
  "action": "keeps the first lines",
  "description": "Pipeline glue for top-N lists.",
  "source": "https://www.gnu.org/software/coreutils/manual/html_node/head-invocation.html",
  "requires": {
    "elevation": "none"
  },
  "io": {
    "stdin": "text",
    "stdout": "text"
  },
  "template": "{binary} {flags}",
  "params": [
    {
      "id": "lines",
      "label": "Lines",
      "type": "int",
      "min": 1,
      "flag": "-n",
      "common": true,
      "default": 20,
      "explain": "the first {value} lines"
    }
  ],
  "presets": [],
  "ttps": [],
  "execSafe": true
}
