{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pearmanref.github.io/command-lens/schema/paths.schema.json",
  "title": "Command Lens path library",
  "type": "object",
  "required": ["os", "paths"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "os": { "enum": ["linux", "windows"] },
    "paths": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "os", "label", "value"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "os": { "enum": ["linux", "windows"] },
          "kind": { "enum": ["file", "dir", "registry"] },
          "label": { "type": "string" },
          "value": { "type": "string" },
          "expand": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
